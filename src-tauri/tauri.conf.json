{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Draw Plan Order",
  "version": "../package.json",
  "identifier": "nz.co.aec.drawplanorder",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "python tools/pack.py"
  },
  "app": {
    "windows": [
      {
        "title": "Draw · Plan · Order",
        "width": 1440,
        "height": 920,
        "minWidth": 640,
        "minHeight": 460,
        "resizable": true,
        "center": true,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Endless canvas for pen and diagrams",
    "longDescription": "An endless canvas for stylus notes, diagrams and decision trees. Write with the pen, type into text boxes, hold a rough shape to snap it clean, scribble to rub things out.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyODIwNTRGQTg0OTFBRApSV1N0a1lUNlZDQW9Ed2FydlFIVEduQXFaTkY0Undyazc3LzNVeFRaQ01HNmNUSE9WNVlqcjd4bwo=",
      "endpoints": ["https://github.com/JammingDino/draw-plan-order/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
